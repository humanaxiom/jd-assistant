# Copy to `.env` AT THE REPO ROOT (beside docker-compose.yml) and edit — that is the
# file `docker compose` interpolates into every service's environment. A `.env` inside
# `core/` does nothing.
#
# `.env` is gitignored; THIS file is committed, so every value in it is public —
# nothing here is a secret, and production refuses to start while it is still carrying
# the committed DATABASE_URL / NEO4J_PASSWORD below (core/src/settings.py,
# `_unsafe_for_production`). Every key the startup check can demand is wired through
# docker-compose.yml's `&app_env` anchor as `${KEY:-default}`, so setting it here
# really does reach the containers; `tests/unit/test_compose_env_delivery.py` fails if
# one of them is missing or pinned to a literal. Four keys below are NOT interpolated
# and are marked where they appear — AGENT_MODEL, EMBED_MODEL, MAX_REVIEW_ITERATIONS
# and COVERAGE_THRESHOLD are anchor literals; change those in docker-compose.yml.

# ── Deployment posture (P0.2) ────────────────────────────────────────────────
# `development` (the default) or `production` — nothing else; a typo is refused rather
# than aliased. In `production` the service REFUSES TO START unless the whole block
# below holds: CAS on, no dev-fake user, TLS verified, an https non-localhost service
# origin, a secure cookie, real database/Neo4j credentials, and an allow-listed
# inference host. That refusal names every unmet setting at once and no value.
ENVIRONMENT=development

# ── Auth / CAS SSO (ADR-008) ─────────────────────────────────────────────────
# CAS_ENABLED=false is the DEV posture and it is not a small thing: with CAS off every
# request — including one with no cookie, from anywhere — resolves to a synthetic user
# holding CAS_DEV_DEFAULT_ROLE (admin). Never deploy with it.
CAS_ENABLED=false
CAS_SERVICE_BASE_URL=http://localhost:25800
# Derive that origin from the X-Forwarded-Host header instead. The header is
# client-controllable and its proto defaults to http, so production refuses to start
# with it on — leave it false and pin CAS_SERVICE_BASE_URL.
CAS_SERVICE_FROM_REQUEST=false
CAS_VERIFY_TLS=true
# Mints a session for this username WITHOUT contacting cas.sfu.ca — dev only; must be
# empty in production.
CAS_DEV_FAKE_USER=
# Who the first admin is. CAS usernames (comma-separated) granted `admin` on every
# login, so there is someone who can grant roles to everyone else. Set it to the
# deploying admin's SFU id before the first production login, or nobody can administer
# the pilot.
BOOTSTRAP_ADMINS=
# Cookies over HTTPS only. MUST be true in production (and true requires an https
# CAS_SERVICE_BASE_URL, or the cookie is never sent and login cannot complete).
SESSION_COOKIE_SECURE=false
# The actor a CAS-off deployment attributes every action to. Must not be blank in any
# mode: a blank one writes an empty actor into the append-only audit chain.
CAS_ANONYMOUS_USER=dev-anonymous

# ── Inference (ADR-003 / NN #5) ──────────────────────────────────────────────
# Self-hosted only. The host must be on ALLOWED_INFERENCE_HOSTS (or a loopback/private
# address); a third-party or cloud endpoint is refused at client construction AND at
# settings load in production. Moving inference OFF a trusted segment is a FIPPA
# question (NN #5) — re-decide it, do not just append a host here.
OLLAMA_BASE_URL=http://aria-gb10-2:11434/v1
ALLOWED_INFERENCE_HOSTS=aria-gb10-2,localhost,127.0.0.1,host.docker.internal
# NOT interpolated — compose pins these two. Setting them here has no effect.
AGENT_MODEL=qwen2.5-coder:14b
EMBED_MODEL=nomic-embed-text

# ── Data stores ──────────────────────────────────────────────────────────────
# The two values below are the COMMITTED dev credentials. They are in git; they are not
# secrets. Replace both before deploying — production will not start otherwise.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/harness
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=harnesspass
REDIS_URL=redis://redis:6379/0

# ── Agent pipeline ───────────────────────────────────────────────────────────
# NOT interpolated — compose pins these two. Setting them here has no effect.
MAX_REVIEW_ITERATIONS=5
COVERAGE_THRESHOLD=80
