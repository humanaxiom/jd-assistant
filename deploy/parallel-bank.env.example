# A SECOND JD Bank, beside the live one — copy this to `.env` in the ROOT of the OTHER
# checkout (beside its docker-compose.yml) and edit. Never put it in the live checkout.
#
#   git worktree add C:\repos\JD-Assistant-v9 parser-v9
#   copy deploy\parallel-bank.env.example C:\repos\JD-Assistant-v9\.env
#   cd C:\repos\JD-Assistant-v9
#   .\build.ps1 ; .\launch.ps1 -NoCas            # its own images, containers, volumes
#   .\teardown.ps1 -Volumes                      # discards THIS Bank only
#
# `.env` is git-ignored, so each checkout keeps its own. `docker compose` reads it on its
# own, and every script (build / launch / teardown / bundle / install) and `make` target
# resolves the project, tag and ports the SAME way compose does — shell environment
# first, then this file, then the live defaults — and prints what it is about to act on.
# See deploy/README.md, "Running a second Bank beside the live one".
#
# Values below are an EXAMPLE for a v9 Bank. Change all of them together for another.

# ── Identity — the two keys that make it a different Bank ────────────────────
# The compose project: containers `<project>-api-1`, volumes `<project>_pgdata` /
# `<project>_neo4jdata`, network `<project>_default`. Must NOT be `jd-bank` (the live one).
COMPOSE_PROJECT_NAME=jd-bank-v9
# The app image tag: `jd-bank-api:<tag>` / `jd-bank-worker:<tag>`. Must NOT be `latest`
# — that tag is the live stack's images, and a build here would overwrite them. The
# scripts refuse a non-live project still on `latest`.
JD_IMAGE_TAG=v9

# ── Host ports — the 26xxx block (live is 25xxx; never a service default) ────
JD_API_PORT=26800
JD_PG_PORT=26432
JD_NEO4J_HTTP_PORT=26474
JD_NEO4J_BOLT_PORT=26687
JD_REDIS_PORT=26379

# ── Auth — CAS OFF: dev-admin access on this Bank's own port ─────────────────
# The return origin is THIS Bank's port, so nothing here can send a browser back to the
# live Bank. To try real CAS on the second Bank set CAS_ENABLED=true and
# BOOTSTRAP_ADMINS=<your-sfu-id>; whether cas.sfu.ca will return to localhost:26800 is
# NOT verified — the live stack's own login is unaffected either way, because its
# `.env` is a different file in a different checkout.
CAS_ENABLED=false
CAS_SERVICE_BASE_URL=http://localhost:26800
ALLOWED_SERVICE_ORIGINS=http://localhost:26800
